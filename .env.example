# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional server-side provider selection (default: anthropic).
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=
OPENAI_CHAT_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# Supabase: server calls PostgREST/GoTrue with the user's own JWT.
# An sb_publishable_... key also works as SUPABASE_ANON_KEY.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Browser-exposed Supabase config (same project, anon key only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin allowlist (comma-separated), required in production.
ALLOWED_ORIGINS=

# Optional: number of trusted reverse-proxy hops when parsing X-Forwarded-For
# for the per-IP rate-limit bucket (default: 1).
TRUSTED_PROXY_HOPS=
